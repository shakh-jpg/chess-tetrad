# Cloud (Supabase) for accounts and sync. Copy to .env.local for local testing; never commit real values.
# Leave empty to keep the app fully local (no accounts).
# Project URL, e.g. https://abcdefghijklmnop.supabase.co  (Supabase -> Settings -> API Keys / Connect)
VITE_SUPABASE_URL=
# The PUBLIC key only: "Publishable key" (sb_publishable_...) or the legacy "anon" key.
# It is safe in the browser because every table has Row Level Security.
# NEVER put the secret key (sb_secret_...) or the legacy service_role key here or anywhere in this repository.
VITE_SUPABASE_ANON_KEY=
